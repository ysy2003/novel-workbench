# 将本文件复制为 .env，在本机填写，勿提交真实密钥。
# 需要提供方明确支持 Chat Completions 格式；填完整的请求 URL。
NOVEL_API_URL=
NOVEL_MODEL=
NOVEL_API_KEY=
NOVEL_API_TIMEOUT=120
NOVEL_MAX_OUTPUT_TOKENS=8192

# 可选：“规划本章”的思考强度。low/high/max 发送 reasoning_effort；off 关闭思考（DeepSeek 的 thinking 字段）；留空不发送。
# 其他任务不受影响。服务商不支持这些字段时请留空。
NOVEL_PLAN_REASONING=

# 可选：评测报告用来估算费用的价格，单位是元 / 百万 tokens，按服务商价目表填写；不填就只显示 tokens。
# NOVEL_PRICE_INPUT=
# NOVEL_PRICE_OUTPUT=

# 可选：指定数据库；默认 data/novels.sqlite3。
# NOVEL_DB_PATH=/absolute/path/to/novels.sqlite3
